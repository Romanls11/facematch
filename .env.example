APP_NAME=FaceMatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=facematch
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------
# FaceMatch
# ---------------------------------------------------------------

# Motor: local (gratis, sin conexión) | rekognition (Amazon)
FACE_ENGINE=local
FACE_DEFAULT_THRESHOLD=80

# Motor local (Node 18+). En Windows usa la ruta completa: `php artisan serve`
# no pasa el PATH a los procesos hijos.
# FACE_NODE_BINARY="C:/Program Files/nodejs/node.exe"
FACE_NODE_BINARY=node
# Distancia euclidiana que equivale al 80 % de similitud
FACE_LOCAL_MATCH_DISTANCE=0.6
# Detector del modo Comparar: tiny (rápido, reintenta con ssd) | ssd (preciso)
FACE_LOCAL_DETECTOR=tiny

# Servicio persistente (modo rápido): php artisan face:serve
FACE_SERVICE_URL=http://127.0.0.1:3311
# Token compartido entre Laravel y el servicio. Genéralo con: php artisan facematch:tokens
FACE_SERVICE_TOKEN=

# Envío del resultado al otro proyecto (POST multipart con ambas imágenes)
FACE_FORWARD_URL=
FACE_FORWARD_TOKEN=
FACE_FORWARD_ONLY_MATCHES=true

# API de FaceMatch (Bearer). Vacío = API deshabilitada (503). Genéralo con: php artisan facematch:tokens
FACE_API_TOKEN=
FACE_API_RATE_LIMIT=60

# Minutos de validez de las URLs firmadas de las imágenes (API y envío)
FACE_IMAGE_URL_TTL=1440

# Registro de actividad (storage/logs/facematch-AAAA-MM-DD.log, ver /registros). null = desactivado
FACE_LOG_CHANNEL=facematch
FACE_LOG_DAYS=30

# Amazon Rekognition (FACE_ENGINE=rekognition)
REKOGNITION_TEST_MODE=true
REKOGNITION_SIMULATE_SCENARIO=match
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

VITE_APP_NAME="${APP_NAME}"
